<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net6.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>3.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeReferencedProjectInPackage</TargetsForTfmSpecificContentInPackage-->
    <RepositoryUrl>https://github.com/ITVenture/Scheduled-Tasks</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Mvc\**" />
    <EmbeddedResource Remove="Mvc\**" />
    <None Remove="Mvc\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="itvcomponents.efrepo" Version="3.1.0" />
    <PackageReference Include="itvcomponents.plugins.databasedrivenconfiguration" Version="3.1.0" />
    <PackageReference Include="ITVComponents.WebCoreToolkit" Version="3.1.0" />
    <PackageReference Include="ITVComponents.WebCoreToolkit.EntityFramework" Version="3.1.0" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.27" />
    <PackageReference Include="microsoft.entityframeworkcore.design" Version="6.0.27">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="6.0.8" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeriodicTasks.DbContext\PeriodicTasks.DbContext.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
</Project>