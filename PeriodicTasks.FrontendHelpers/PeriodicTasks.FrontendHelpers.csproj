<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>3.1.0</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <RepositoryUrl>https://github.com/ITVenture/Scheduled-Tasks</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <!-- Resources -->
    <EmbeddedResource Update="Properties\Resources.resx" Generator="ResXFileCodeGenerator" LastGenOutput="Resources.Designer.cs" />
    <Compile Update="Properties\Resources.Designer.cs" AutoGen="True" DependentUpon="Resources.resx" DesignTime="True" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="itvcomponents.dataaccess" Version="4.0.0-PRE055" />
    <PackageReference Include="ITVComponents.Formatting" Version="4.0.0-PRE055" />
    <PackageReference Include="itvcomponents.interprocesscommunication.managementextensions" Version="4.0.0-PRE055" />
    <PackageReference Include="itvcomponents.interprocesscommunication.shared" Version="4.0.0-PRE055" />
    <PackageReference Include="itvcomponents.parallelprocessing" Version="4.0.0-PRE055" />
    <!--PackageReference Include="itvcomponents.plugins" Version="3.0.11" /-->
    <PackageReference Include="itvcomponents.plugins.databasedrivenconfiguration" Version="4.0.0-PRE055" />
    <PackageReference Include="ITVComponents.WebCoreToolkit" Version="4.0.0-PRE055" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeriodicTasks\PeriodicTasks.csproj" />
  </ItemGroup>
</Project>