<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFrameworks>net8.0</TargetFrameworks>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Version>4.0.0-PRE005</Version>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!--TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeReferencedProjectInPackage</TargetsForTfmSpecificContentInPackage-->
    <RepositoryUrl>https://github.com/ITVenture/Scheduled-Tasks</RepositoryUrl>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Mvc\**" />
    <EmbeddedResource Remove="Mvc\**" />
    <None Remove="Mvc\**" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="itvcomponents.efrepo" Version="4.0.0-PRE055" />
    <PackageReference Include="itvcomponents.plugins.databasedrivenconfiguration" Version="4.0.0-PRE055" />
    <PackageReference Include="ITVComponents.WebCoreToolkit" Version="4.0.0-PRE055" />
    <PackageReference Include="ITVComponents.WebCoreToolkit.EntityFramework" Version="4.0.0-PRE055" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.14" />
    <PackageReference Include="microsoft.entityframeworkcore.design" Version="8.0.14">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.SqlServer" Version="8.0.14" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\PeriodicTasks.DbContext\PeriodicTasks.DbContext.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Folder Include="Properties\" />
  </ItemGroup>
